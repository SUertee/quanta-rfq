# Copy to .env.local. Never commit .env.local or credentials.
# Model endpoint must use HTTPS. Use an OpenAI-compatible API with tool calling.
RFQ_LLM_BASE_URL=https://api.example.com/v1
RFQ_LLM_API_KEY=
VITE_LLM_MODEL=your-model-name
# Optional OCR service; leave unset when unavailable.
# RFQ_OCR_BASE_URL=https://ocr.example.com/api/v1
# RFQ_OCR_API_KEY=
# RFQ_PORT=3004
# Never put credentials in VITE_* variables (they can enter browser bundles).
