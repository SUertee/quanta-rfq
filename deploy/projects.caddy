projects.suertexu.com {
    @assets path /quanta-rfq/assets/*
    encode @assets gzip
    @rfq path /quanta-rfq /quanta-rfq/*
    handle @rfq {
        reverse_proxy quanta-rfq:3000 {
            flush_interval -1
        }
    }
    handle / {
        header Content-Type "text/html; charset=utf-8"
        respond "<!doctype html><html lang=\"zh-CN\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Projects</title><body style=\"margin:0;background:#f5f7fb;color:#0b1d3a;font-family:system-ui,sans-serif\"><main style=\"max-width:760px;margin:12vh auto;padding:24px\"><h1 style=\"font-weight:500\">Projects</h1><a href=\"/quanta-rfq/?workspace=1\" style=\"display:block;padding:24px;border:1px solid #dce3ec;border-radius:16px;color:inherit;text-decoration:none;background:white;font-size:20px\">Quanta RFQ <span style=\"float:right\">→</span></a></main></body></html>" 200
    }
    handle {
        respond "Not found" 404
    }
}
